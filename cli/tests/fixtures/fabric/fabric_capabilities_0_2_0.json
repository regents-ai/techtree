  "unresolved_for_release": {
    "codex_fresh_home_network_fetch": {
      "evidence_refs": [
        "codex_fresh_home_plugin_cache"
      ],
      "finding": "Codex populated a plugin cache from the network on first start in a fresh Fabric-owned home, so the run is not hermetic as shipped.",
      "kind": "observed"
    },
    "codex_home_inheritance": {
      "evidence_refs": [
        "codex_adapter_inherited_env",
        "codex_adapter_child_environment"
      ],
      "finding": "For an OpenAI provider coordinate the Codex adapter passes the parent HOME, CODEX_HOME and OPENAI_API_KEY to the harness, so Techtree must supply owned values. Read from the adapter source; the OpenAI path itself was not run.",
      "kind": "source_proven_path_not_executed"
    },
    "doctor_raises_instead_of_reporting_for_tool_definitions": {
      "evidence_refs": [
        "admission_matrix"
      ],
      "finding": "For tools.definitions both adapters made Doctor raise a FabricConfigError rather than return a report with a failing check, so a caller cannot collect that rejection alongside the other checks. Planning still refuses the control before execution, so nothing reaches spend, but Techtree must handle both shapes of refusal.",
      "kind": "observed"
    },
    "harness_presence_unchecked_before_admission": {
      "evidence_refs": [
        "lifecycle"
      ],
      "finding": "Neither shipped descriptor declares requirements, so Fabric Doctor returns pass with no harness installed and the absence is only discovered at lifecycle start. Techtree must gate harness presence itself.",
      "kind": "observed"
    },
    "hermes_agent_supply_above_0_19_0": {
      "evidence_refs": [
        "nemo_fabric_hermes_harness_supply",
        "index_queries"
      ],
      "finding": "NVIDIA states that Hermes Agent 0.20 and later is not installable from PyPI, and the index offered nothing above 0.19.0 when queried. Neither observation proves what exists outside PyPI, so how Techtree would obtain a newer harness is unresolved.",
      "kind": "vendor_stated_and_index_consistent_not_proven"
    },
    "no_usage_accounting": {
      "evidence_refs": [
        "lifecycle"
      ],
      "finding": "The normalized run result carried a null usage record, so Fabric supplies no token or cost accounting for a subject run. Observed only on runs that terminated at invoke.",
      "kind": "observed_on_failed_invoke_only"
    },
    "streaming_updates_and_cancellation_declared_false": {
      "evidence_refs": [
        "admission_matrix",
        "fabric_native_interface"
      ],
      "finding": "Both descriptors resolve with service, streaming, updates and cancellation declared false. This is a descriptor declaration, not an observed attempt: no cancellation, update or streaming call was made. The native surface does expose an invoke_openai_stream entry point, which this spike did not exercise.",
      "kind": "declared_by_descriptor_untested"
    }
  }
