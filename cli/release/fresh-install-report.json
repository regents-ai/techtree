  "observations": [
    {
      "id": "default_interpreter_ignores_requires_python",
      "severity": "note for WP11e and Gate 2",
      "detail": "The wheel declares Requires-Python <3.14,>=3.12. Left to choose for itself, uv 0.10.2 built the tool environment on Python 3.14.3, which the package says it does not support. All five commands pass on it anyway, so this is not a release stop, but a clean-machine install can land on an interpreter outside the tested range without saying so. The second install pins 3.12 and is the supported path."
    }
