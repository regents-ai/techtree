# The bootstrap image Techtree builds when a person gives no Dockerfile.
#
# A uv-managed Python project: the checkout is copied to /workspace with its
# history, and the locked environment is built there so the declared test
# commands run as they do on the person's machine. Repo2RLEnv's task images
# start FROM this one and reset /workspace to each task's base commit.
FROM python:3.12-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates \
 && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:0.12.7 /uv /uvx /usr/local/bin/

ENV UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/workspace/.venv \
    PATH="/workspace/.venv/bin:${PATH}"

COPY . /workspace
WORKDIR /workspace

RUN git config --global --add safe.directory /workspace \
 && uv sync --frozen
