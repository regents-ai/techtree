{
  "name": "techtree-assets",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Vendored browser dependencies for the Techtree site. esbuild bundles them from here into priv/static/assets, so the strict script-src 'self' policy holds and nothing is fetched at runtime.",
  "license": "MIT",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@privy-io/react-auth": "3.51.1",
    "@solana-program/system": "0.16.0",
    "@solana-program/token": "0.18.0",
    "@solana/kit": "8.6.0",
    "@vgpu/wgsl": "0.6.0",
    "animejs": "4.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vgpu": "0.6.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@webgpu/types": "0.1.74",
    "typescript": "7.0.2"
  },
  "overrides": {
    "ws@^8.0.0": "8.22.1",
    "axios": "1.21.0",
    "decode-uri-component": "0.5.1",
    "uuid": "14.0.3",
    "@modelcontextprotocol/server": "2.4.0",
    "@modelcontextprotocol/core": "2.4.0",
    "zod": "4.6.7"
  }
}
