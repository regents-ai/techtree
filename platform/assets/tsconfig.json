{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "@webgpu/types"
    ],
    "noEmit": true,
    "jsx": "react-jsx"
  },
  "include": [
    "js/**/*.ts",
    "js/**/*.tsx"
  ]
}
