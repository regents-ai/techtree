<!DOCTYPE html>
<html lang="en" data-theme={assigns[:theme]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="techtree-revision" content={Techtree.BuildInfo.source_revision()} />
    <meta
      name="color-scheme"
      content={if(assigns[:theme] == "orange", do: "light", else: "dark")}
    />
    <meta
      id="theme-color"
      name="theme-color"
      content={if(assigns[:theme] == "orange", do: "#f4eee4", else: "#101010")}
    />
    <meta
      name="description"
      content={page_description(assigns)}
    />
    <.live_title default="Techtree" suffix=" · Techtree">
      {assigns[:page_title]}
    </.live_title>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/css/site.css"}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/site.js"}
    >
    </script>
  </head>
  <body>
    <a :if={masthead_visible?(assigns)} class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <div
      id="site-background"
      class="site-background"
      data-optics-kind="background"
      data-optics-source={~p"/assets/js/background_island.js"}
      data-background-theme={assigns[:theme]}
      data-background-preset="10"
      aria-hidden="true"
    >
      <canvas
        id="site-background-canvas"
        class="site-background__canvas"
        data-optics-canvas
        data-background-theme={assigns[:theme]}
        data-background-preset="10"
      >
      </canvas>
    </div>
    <.masthead
      :if={masthead_visible?(assigns)}
      current_path={request_path(assigns)}
      theme={assigns[:theme] || "orange"}
    />
    {@inner_content}
  </body>
</html>
