<!DOCTYPE html>
<html lang="en" data-brand="techtree" data-theme={assigns[:theme]}>
  <head>
    <meta charset="utf-8" />
    <link rel="alternate" type="text/plain" title="Agent guide" href={~p"/llms.txt"} />
    <%!-- The lens agent-readiness readers take: a product people use. --%>
    <meta name="is-agentic-site-type" content="app" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta name="techtree-revision" content={Techtree.BuildInfo.source_revision()} />
    <meta
      name="color-scheme"
      content={if(assigns[:theme] == "light", do: "light", else: "dark")}
    />
    <meta
      id="theme-color"
      name="theme-color"
      content={if(assigns[:theme] == "light", do: "#F6F4EA", else: "#161616")}
    />
    <meta
      name="description"
      content={page_description(assigns)}
    />
    <.live_title default="Techtree" suffix=" · Techtree">
      {assigns[:page_title]}
    </.live_title>
    <link rel="canonical" href={canonical_url(assigns)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Techtree" />
    <meta property="og:title" content={share_title(assigns[:page_title])} />
    <meta property="og:description" content={page_description(assigns)} />
    <meta property="og:url" content={canonical_url(assigns)} />
    <meta property="og:image" content={url(~p"/images/techtree-share.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Techtree: Improve a Skill. Prove it worked." />
    <meta name="twitter:card" content="summary_large_image" />
    <script :if={request_path(assigns) == "/"} type="application/ld+json">
      <%= structured_data() %>
    </script>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/css/site.css"}
    />
    <script
      defer
      phx-track-static
      type="text/javascript"
      src={~p"/assets/js/site.js"}
    >
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <Regent.Structure.frame class="techtree-frame">
      <.masthead
        current_path={request_path(assigns)}
        theme={assigns[:theme] || "light"}
      />
      {@inner_content}
    </Regent.Structure.frame>
  </body>
</html>
