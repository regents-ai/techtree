<!DOCTYPE html>
<html lang="en" data-brand="techtree" data-theme={assigns[:theme]} data-aside={@aside}>
  <head>
    <meta name="agent-request-origin" content={TechtreeWeb.Endpoint.url()} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta :if={assigns[:session_refused]} name="session-refused" content="true" />
    <meta name="privy-app-id" content={Application.get_env(:techtree, :privy, [])[:app_id]} />
    <meta :if={assigns[:visit]} name="regent-visit" content={assigns[:visit]} />
    <meta
      name="privy-bridge-src"
      content={TechtreeWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <meta name="techtree-revision" content={Techtree.BuildInfo.source_revision()} />
    <meta name="color-scheme" content={assigns[:theme] || "dark light"} />
    <meta
      :if={assigns[:theme]}
      name="theme-color"
      content={if(assigns[:theme] == "light", do: "#F3F5EF", else: "#0D1611")}
    />
    <meta
      :if={!assigns[:theme]}
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#F3F5EF"
    />
    <meta
      :if={!assigns[:theme]}
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0D1611"
    />
    <.live_title default="Techtree" suffix=" · Techtree">
      {assigns[:page_title]}
    </.live_title>
    <%!-- site_type "app": the lens agent-readiness readers take, a product people use. --%>
    <Regent.AgentMetadata.head
      title={share_title(assigns[:page_title])}
      description={page_description(assigns)}
      canonical={canonical_url(assigns)}
      site_name="Techtree"
      site_type="app"
      image={url(~p"/images/techtree-share.png")}
      image_width={1200}
      image_height={630}
      image_alt="Techtree: upgrade a Skill, Harness, or Env."
      markdown={TechtreeWeb.Plugs.PageMarkdown.markdown?(@conn)}
      agent_guide={~p"/llms.txt"}
      sitemap={~p"/sitemap.xml"}
      service_description={~p"/openapi.json"}
      structured_data={structured_data()}
    />
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <%!-- The heading and body faces load with the stylesheet, so text is first drawn in them and nothing moves when they arrive. --%>
    <link
      :for={
        font <- [
          ~p"/fonts/regent-ui/GeistPixel-Square.woff2",
          ~p"/fonts/regent-ui/Geist-Regular.woff2",
          ~p"/fonts/regent-ui/Geist-SemiBold.woff2"
        ]
      }
      rel="preload"
      as="font"
      type="font/woff2"
      crossorigin
      href={font}
    />
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/css/site.css"}
    />
    <script
      defer
      phx-track-static
      type="module"
      src={~p"/assets/js/site.js"}
    >
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <Regent.Structure.frame class="techtree-frame">
      <.masthead current_path={request_path(assigns)}>
        {live_render(@conn, TechtreeWeb.SidePanelLive,
          container: {:div, class: "masthead__account"},
          session: TechtreeWeb.Live.Session.render_context(@conn)
        )}
      </.masthead>
      {@inner_content}
    </Regent.Structure.frame>
  </body>
</html>
