<!DOCTYPE html>
<html lang="en" data-brand="techtree" data-theme={assigns[:theme]} data-aside={@aside}>
  <head>
    <meta name="agent-request-origin" content={TechtreeWeb.Endpoint.url()} />
    <meta charset="utf-8" />
    <link rel="alternate" type="text/plain" title="Agent guide" href={~p"/llms.txt"} />
    <%!-- The lens agent-readiness readers take: a product people use. --%>
    <meta name="is-agentic-site-type" content="agent tool platform" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <meta :if={assigns[:session_refused]} name="session-refused" content="true" />
    <meta name="privy-app-id" content={Application.get_env(:techtree, :privy, [])[:app_id]} />
    <meta
      name="privy-bridge-src"
      content={TechtreeWeb.Endpoint.static_path("/assets/js/privy_bridge.js")}
    />
    <meta name="techtree-revision" content={Techtree.BuildInfo.source_revision()} />
    <meta name="color-scheme" content={assigns[:theme] || "dark light"} />
    <meta
      :if={assigns[:theme]}
      name="theme-color"
      content={if(assigns[:theme] == "light", do: "#F3F5EF", else: "#0D1611")}
    />
    <meta
      :if={!assigns[:theme]}
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#F3F5EF"
    />
    <meta
      :if={!assigns[:theme]}
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#0D1611"
    />
    <meta
      name="description"
      content={page_description(assigns)}
    />
    <.live_title default="Techtree" suffix=" · Techtree">
      {assigns[:page_title]}
    </.live_title>
    <link rel="canonical" href={canonical_url(assigns)} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Techtree" />
    <meta property="og:title" content={share_title(assigns[:page_title])} />
    <meta property="og:description" content={page_description(assigns)} />
    <meta property="og:url" content={canonical_url(assigns)} />
    <meta property="og:image" content={url(~p"/images/techtree-share.png")} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Techtree: upgrade a Skill, Harness, or Env." />
    <meta name="twitter:card" content="summary_large_image" />
    <script :if={request_path(assigns) == "/"} type="application/ld+json">
      <%= structured_data() %>
    </script>
    <link rel="icon" type="image/svg+xml" href={~p"/favicon.svg"} />
    <link rel="icon" type="image/png" sizes="32x32" href={~p"/favicon-32.png"} />
    <link rel="apple-touch-icon" href={~p"/apple-touch-icon.png"} />
    <link
      phx-track-static
      rel="stylesheet"
      href={~p"/assets/css/site.css"}
    />
    <script
      defer
      phx-track-static
      type="module"
      src={~p"/assets/js/site.js"}
    >
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">
      Skip to main content
    </a>
    <Regent.Structure.frame class="techtree-frame">
      <.masthead current_path={request_path(assigns)}>
        {live_render(@conn, TechtreeWeb.SidePanelLive,
          container: {:div, class: "masthead__account"},
          session: TechtreeWeb.Live.Session.render_context(@conn)
        )}
      </.masthead>
      {@inner_content}
    </Regent.Structure.frame>
  </body>
</html>
