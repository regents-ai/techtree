<!DOCTYPE html>
<html lang="en" data-theme="orange">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Something went wrong · Techtree</title>
    <link rel="stylesheet" href={~p"/assets/css/site.css"} />
  </head>
  <body>
    <main class="error-page">
      <a class="error-page__name" href={~p"/"}>Techtree</a>
      <p class="eyebrow">500</p>
      <h1>Techtree could not load this page.</h1>
      <p>Try again. If the problem continues, report it in the project repository.</p>
      <nav aria-label="Return to Techtree">
        <a href={~p"/"}>Home</a>
        <a href="https://github.com/regents-ai/techtree/issues">Report the problem</a>
      </nav>
    </main>
  </body>
</html>
