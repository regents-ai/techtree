<!DOCTYPE html>
<html lang="en" data-theme="orange">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found · Techtree</title>
    <link rel="stylesheet" href={~p"/assets/css/site.css"} />
  </head>
  <body>
    <main class="error-page">
      <a class="error-page__name" href={~p"/"}>Techtree</a>
      <p class="eyebrow">404</p>
      <h1>This page is not part of Techtree.</h1>
      <p>
        The public site contains setup, Results, verification, Docs, and Climb contracts.
      </p>
      <nav aria-label="Return to Techtree">
        <a href={~p"/"}>Home</a>
        <a href={~p"/results"}>Results</a>
        <a href={~p"/docs"}>Docs</a>
      </nav>
    </main>
  </body>
</html>
