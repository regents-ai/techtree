<!DOCTYPE html>
<html lang="en" data-brand="techtree" data-theme={error_theme(assigns)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>We can’t find that page · Techtree</title>
    <link rel="stylesheet" href={~p"/assets/css/site.css"} />
  </head>
  <body>
    <Regent.Structure.frame>
      <main id="main-content" class="error-page">
        <a class="error-page__name" href={~p"/"}>Techtree</a>
        <p class="eyebrow">404</p>
        <h1>We can’t find that page</h1>
        <p>
          The public site contains setup, Results, verification, Docs, and Climb contracts.
        </p>
        <nav aria-label="Return to Techtree">
          <a href={~p"/"}>Home</a>
          <a href={~p"/results"}>Results</a>
          <a href={~p"/docs"}>Docs</a>
        </nav>
      </main>
    </Regent.Structure.frame>
  </body>
</html>
