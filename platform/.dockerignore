# What the image build never needs to see.
#
# Read this beside `.gitignore` rather than as a copy of it. Two directories
# are ignored by git and must still reach the build, because they are what the
# deployed site publishes:
#
#   priv/catalog   the generated bundle, synced by scripts/sync_catalog.exs
#   priv/release   the starter Skill, byte-identical to its source of truth
#
# A build whose context is missing them produces an image that serves nothing.

.git
.gitignore

# Build output and dependency sources: the image builds its own, for its own
# architecture and MIX_ENV.
_build
deps
cover
doc
.fetch
*.ez
erl_crash.dump
techtree-*.tar

# Assets are compiled, digested, and compressed inside the image by
# `mix assets.deploy`. A copy built on a developer's machine would be stale.
assets/node_modules
priv/static/assets
priv/static/cache_manifest.json
priv/static/**/*.gz
npm-debug.log

# Tests, scratch space, and editor state are not part of what is served.
test
tmp
.elixir_ls
.lexical
.vscode
.idea
.DS_Store

# Documentation and host configuration describe the deploy; they are not in it.
docs
scripts
AGENTS.md
README.md
LICENSE
fly.toml
.dockerignore
Dockerfile
.formatter.exs
.claude
